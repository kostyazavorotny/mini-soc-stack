import requests
import time
import re

OPENSEARCH_URL = "http://opensearch:9200/_search"
≈≈
ATTACK_PATTERNS = {
    "SQL Injection": r"(?i)(union.*select|select.*from|exec\(|drop.*table|'OR'1'='1)",
    "Path Traversal / LFI": r"(\.\./\.\./|\.\.\\\.\.\\|/etc/passwd)",
    "Web Scanner (Nikto/Nmap)": r"(?i)(nikto|nmap|sqlmap|masscan)"
}

# Специальная функция для моментального вывода в консоль Docker
def log_msg(msg):
    print(msg, flush=True)

def query_logs():
    # Убрали сортировку, чтобы точно не было ошибок из-за структуры лога
    query = {
        "size": 50,
        "query": {
            "match_all": {}
        }
    }
    
    try:
        response = requests.post(OPENSEARCH_URL, json=query, timeout=5)
        if response.status_code == 200:
            hits = response.json().get('hits', {}).get('hits', [])
            if not hits:
                log_msg("[*] База отвечает, но логи пока не дошли. Ждем...")
                return
            
            log_msg(f"[*] Найдено логов: {len(hits)} шт. Проверяем на атаки...")
            
            for hit in hits:
                # Превращаем весь JSON лога в строку
                log_str = str(hit.get('_source', {}))
                
                for attack_type, pattern in ATTACK_PATTERNS.items():
                    if re.search(pattern, log_str):
                        log_msg(f"\n[🚨 SECURITY ALERT] {attack_type} Detected!")
                        log_msg(f"  └─ Payload: {log_str[:200]}...")
                        break 
        else:
            log_msg(f"[!] Ошибка БД (код {response.status_code}): {response.text}")
    except requests.exceptions.RequestException as e:
        log_msg(f"[!] Ошибка подключения к базе: {e}")

if __name__ == "__main__":
    log_msg("[*] SOC Detector запущен. Начинаем мониторинг...")
    time.sleep(5)
    while True:
        query_logs()
        time.sleep(5)
